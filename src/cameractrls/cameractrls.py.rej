+# --- Suporte a idiomas (Portugues / English) para o painel Intel NPU Effects ---
+# Todas as strings PT permanecem no local original de cada IntelNPUCtrl/BaseCtrlMenu
+# como o texto "padrao"/fallback; NPU_TR guarda apenas as traducoes para 'en'.
+# npu_translate() e npu_detect_system_language() decidem, em tempo real, qual
+# texto exibir (ver uso do helper local T(...) dentro de get_device_controls()).
+
+def npu_detect_system_language():
+    for var in ('LC_ALL', 'LC_MESSAGES', 'LANGUAGE', 'LANG'):
+        val = os.environ.get(var, '')
+        if val:
+            val = val.lower()
+            if val.startswith('en'):
+                return 'en'
+            if val.startswith('pt'):
+                return 'pt'
+    return 'pt'
+
