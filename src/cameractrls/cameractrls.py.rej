+def npu_translate(lang, text_id, field, pt_text, menu_id=None):
+    if lang != 'en':
+        return pt_text
+    entry = NPU_TR.get(text_id)
+    if not entry:
+        return pt_text
+    if field == 'menu':
+        return entry.get('menu', {}).get(menu_id, pt_text)
+    return entry.get(field, pt_text)
+
