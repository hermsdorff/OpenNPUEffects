cmd_ptz_delay() {
    ensure_config
    val="$1"
    $VENV_PYTHON -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)

v = '$val'.strip()
if not v:
    cur = cfg.get('video', {}).get('standby_park_delay', 1.0)
    print(f'Atraso atual antes do recolhimento PTZ: {cur}s (câmera desliga primeiro)')
    exit(0)

try:
    d = float(v)
    if d < 0:
        d = 0.0
    cfg['video']['standby_park_delay'] = d
    print(f'Atraso pré-parking PTZ configurado para: {d}s (câmera desliga primeiro, aguarda {d}s e recolhe)')
    with open('$CONFIG_FILE', 'w') as f:
        json.dump(cfg, f, indent=2)
except Exception as e:
    print('Uso: npu-ctl ptz-delay [segundos, ex: 1.0]')
    exit(1)
"
}

