        echo "  npu-ctl ptz-park [on|off]        Ativa ou desativa recolhimento PTZ (tilt -324000) no standby"
        echo "  npu-ctl ptz-delay [segundos]     Atraso após desativar câmera antes do recolhimento PTZ (padrão: 1.0s)"
        echo "  npu-ctl ptz-tilt <fechar> [abrir] Calibra valor de tilt do standby (fechar) e wakeup (abrir)"
        echo "  npu-ctl ptz-pan [<val>|off]      Define giro horizontal (pan) para virar para trás (-540000 a 540000)"
