    start)
        systemctl --user start npu-webcam npu-audio
        echo "Serviços iniciados."
        cmd_status
        ;;
    stop)
        systemctl --user stop npu-webcam npu-audio
        echo "Serviços finalizados."
        ;;
    restart)
