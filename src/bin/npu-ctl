    cfg['video']['blur_mode'] = 'portrait_depth'
    cfg['video']['blur_enabled'] = True
    print('Modo de desfoque alterado para: RETRATO ÓPTICO (Profundidade / Bokeh)!')
elif arg in ['standard', 'padrao', 'uniforme']:
    cfg['video']['blur_mode'] = 'standard'
    print('Modo de desfoque alterado para: PADRÃO (Uniforme)!')
else:
    print('Uso: npu-ctl blur-mode [standard | portrait]')
    exit(1)

with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
"
