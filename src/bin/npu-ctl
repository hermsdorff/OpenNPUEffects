cmd_cam_source() {
    ensure_config
    arg="$1"
    $VENV_PYTHON -c "
import glob, json, os, subprocess
from pathlib import Path

CONFIG_FILE = '$CONFIG_FILE'
with open(CONFIG_FILE, 'r') as f:
    cfg = json.load(f)

current_cam = cfg.get('video', {}).get('input_device', 'auto')

# Discover cameras
cameras = []
by_id = Path('/dev/v4l/by-id')
if by_id.exists():
    for link in sorted(by_id.iterdir()):
        if 'video-index0' in link.name:
            try:
                dev = str(link.resolve())
                desc = link.name.split('-video-index0')[0].replace('usb-', '').replace('_', ' ')
                cameras.append({'dev': dev, 'desc': desc, 'alias': 'pixy' if 'pixy' in desc.lower() else ''})
            except Exception:
                pass

by_path = Path('/dev/v4l/by-path')
if by_path.exists():
    for link in sorted(by_path.iterdir()):
        if 'video-index0' in link.name:
            try:
                dev = str(link.resolve())
                if not any(c['dev'] == dev for c in cameras):
                    name_file = Path(f'/sys/class/video4linux/{Path(dev).name}/name')
                    name = name_file.read_text().strip() if name_file.exists() else Path(dev).name
                    alias = 'notebook' if 'ipu6' in name.lower() else ''
                    cameras.append({'dev': dev, 'desc': name, 'alias': alias})
            except Exception:
                pass

for p in sorted(Path('/dev').glob('video*')):
    num_str = p.name.replace('video', '')
    if num_str.isdigit():
        num = int(num_str)
        if num in [70, 71, 72, 50]:
            continue
        dev_str = str(p)
        if not any(c['dev'] == dev_str for c in cameras):
            name_file = Path(f'/sys/class/video4linux/{p.name}/name')
            name = name_file.read_text().strip() if name_file.exists() else p.name
            if 'capture' in name.lower() or 'camera' in name.lower() or 'pixy' in name.lower() or num == 0:
                if 'ipu6 isys capture' in name.lower() and num != 2:
                    continue
                cameras.append({'dev': dev_str, 'desc': name, 'alias': 'notebook' if 'ipu6' in name.lower() or num == 0 else ''})

arg = '$arg'.strip()
if not arg or arg in ['list', 'ls', 'status']:
    print('\n\033[0;36m=== CÂMERAS FÍSICAS DISPONÍVEIS ===\033[0m')
    for i, c in enumerate(cameras, 1):
        is_active = (current_cam == c['dev']) or (current_cam == 'auto' and i == 1)
        tag = ' \033[0;32m[ATIVA]\033[0m' if is_active else ''
        alias_txt = f' (atalho: {c[\"alias\"]})' if c[\"alias\"] else ''
        print(f'  [\033[1;33m{i}\033[0m] {c[\"dev\"]} - {c[\"desc\"]}{alias_txt}{tag}')
    auto_tag = ' \033[0;32m[ATIVA]\033[0m' if current_cam == 'auto' else ''
    print(f'  [\033[1;33mauto\033[0m] Detecção Automática{auto_tag}')
    print('\nPara selecionar uma câmera:')
    print('  npu-ctl cam-source <1, 2, ... | pixy | notebook | /dev/videoX | auto>')
    exit(0)

# Set camera
chosen = None
if arg.lower() == 'auto':
    chosen = 'auto'
elif arg.isdigit():
    idx = int(arg) - 1
    if 0 <= idx < len(cameras):
        chosen = cameras[idx]['dev']
elif arg.startswith('/dev/video'):
    chosen = arg
else:
    for c in cameras:
        if arg.lower() in c['alias'].lower() or arg.lower() in c['desc'].lower() or arg.lower() in c['dev'].lower():
            chosen = c['dev']
            break

if chosen:
    cfg['video']['input_device'] = chosen
    with open(CONFIG_FILE, 'w') as f:
        json.dump(cfg, f, indent=2)
    print(f'\033[0;32m✓ Câmera de entrada NPU definida para: {chosen}!\033[0m')
    print('Reiniciando serviço da webcam para aplicar a troca...')
    subprocess.run(['systemctl', '--user', 'restart', 'npu-webcam.service'])
    print('\033[0;32m✓ Webcam reiniciada e transmitindo a nova câmera em /dev/video72!\033[0m')
else:
    print(f'\033[0;31mCâmera \"{arg}\" não encontrada. Use \"npu-ctl cam-source\" para listar as disponíveis.\033[0m')
    exit(1)
"
}

cmd_mic_source() {
    ensure_config
    arg="$1"
    $VENV_PYTHON -c "
import json, os, subprocess

CONFIG_FILE = '$CONFIG_FILE'
with open(CONFIG_FILE, 'r') as f:
    cfg = json.load(f)

current_mic = cfg.get('audio', {}).get('input_device', 'auto')

# Discover physical microphones from PipeWire
out = subprocess.check_output('pactl list sources short', shell=True).decode(errors='ignore')
mics = []
for line in out.splitlines():
    parts = line.split()
    if len(parts) >= 2:
        name = parts[1]
        nl = name.lower()
        if not (nl.startswith('npu') or 'clearvoice' in nl or '.monitor' in nl or 'null' in nl):
            if 'pixy' in nl:
                label = 'EMEET PIXY (Microfone da Câmera PTZ)'
                alias = 'pixy'
            elif 'generic_usb' in nl or 'usb2.0' in nl:
                label = 'USB2.0 Device (Microfone USB Externo)'
                alias = 'usb'
            elif 'mic1' in nl:
                label = 'Microfone Digital Interno (Samsung Galaxy Book)'
                alias = 'notebook'
            elif 'mic2' in nl:
                label = 'Entrada P2/P3 Headset (Microfone de Fone)'
                alias = 'fone'
            else:
                label = name
                alias = ''
            mics.append({'id': name, 'label': label, 'alias': alias})

arg = '$arg'.strip()
if not arg or arg in ['list', 'ls', 'status']:
    print('\n\033[0;36m=== MICROFONES FÍSICOS DISPONÍVEIS ===\033[0m')
    for i, m in enumerate(mics, 1):
        is_active = (current_mic == m['id']) or (current_mic == 'auto' and i == 2)
        tag = ' \033[0;32m[ATIVO]\033[0m' if is_active else ''
        alias_txt = f' (atalho: {m[\"alias\"]})' if m[\"alias\"] else ''
        print(f'  [\033[1;33m{i}\033[0m] {m[\"label\"]}{alias_txt}{tag}')
        print(f'      ID: \033[0;34m{m[\"id\"]}\033[0m')
    auto_tag = ' \033[0;32m[ATIVO]\033[0m' if current_mic == 'auto' else ''
    print(f'  [\033[1;33mauto\033[0m] Detecção Automática (prioriza USB, depois interno){auto_tag}')
    print('\nPara selecionar um microfone:')
    print('  npu-ctl mic-source <1, 2, ... | pixy | usb | notebook | fone | auto>')
    exit(0)

# Set mic
chosen = None
if arg.lower() == 'auto':
    chosen = 'auto'
elif arg.isdigit():
    idx = int(arg) - 1
    if 0 <= idx < len(mics):
        chosen = mics[idx]['id']
else:
    for m in mics:
        if arg.lower() in m['alias'].lower() or arg.lower() in m['label'].lower() or arg.lower() in m['id'].lower():
            chosen = m['id']
            break

if chosen:
    cfg['audio']['input_device'] = chosen
    with open(CONFIG_FILE, 'w') as f:
        json.dump(cfg, f, indent=2)
    print(f'\033[0;32m✓ Microfone de entrada NPU definido para: {chosen}!\033[0m')
    print('Reiniciando serviço de áudio para aplicar a troca...')
    subprocess.run(['systemctl', '--user', 'restart', 'npu-audio.service'])
    print('\033[0;32m✓ Microfone reiniciado e transmitindo via npu_clearvoice!\033[0m')
else:
    print(f'\033[0;31mMicrofone \"{arg}\" não encontrado. Use \"npu-ctl mic-source\" para listar os disponíveis.\033[0m')
    exit(1)
"
}

cmd_restore_cameractrls() {
    echo -e "${CYAN}Restaurando integração Intel NPU no Cameractrls...${NC}"
    c_dir="$HOME/.local/share/cameractrls"
    if [ -f "$c_dir/cameractrls.py.npu_backup" ]; then
        cp "$c_dir/cameractrls.py.npu_backup" "$c_dir/cameractrls.py"
        echo -e "${GREEN}✓ cameractrls.py restaurado!${NC}"
    fi
    if [ -f "$c_dir/cameractrlsgtk.py.npu_backup" ]; then
        cp "$c_dir/cameractrlsgtk.py.npu_backup" "$c_dir/cameractrlsgtk.py"
        echo -e "${GREEN}✓ cameractrlsgtk.py restaurado!${NC}"
    fi
    echo -e "${GREEN}✓ Cameractrls atualizado com a aba Intel NPU e barra de rolagem permanente.${NC}"
}

