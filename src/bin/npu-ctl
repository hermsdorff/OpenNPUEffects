#!/usr/bin/env bash
#
# npu-ctl: CLI control utility for Intel NPU Webcam and Audio effects
#
CONFIG_FILE="$HOME/.config/npu-effects/config.json"
VENV_PYTHON="$HOME/.local/share/npu-effects/venv/bin/python3"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m' # No Color

ensure_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        mkdir -p "$(dirname "$CONFIG_FILE")"
        echo '{"video":{"enabled":true,"blur_enabled":true,"blur_strength":35,"auto_framing":true,"framing_smoothness":0.04,"framing_smoothness_int":4,"framing_deadzone":0.10,"smooth_enabled":true,"smooth_strength":50,"background_image":""},"audio":{"enabled":true,"noise_suppression":true}}' > "$CONFIG_FILE"
    fi
}

cmd_status() {
    echo -e "${CYAN}====================================================${NC}"
    echo -e "${CYAN}        INTEL CORE ULTRA 9 - PAINEL NPU AI          ${NC}"
    echo -e "${CYAN}====================================================${NC}"
    
    # 1. NPU Hardware Check
    echo -e "\n${BLUE}[Hardware NPU]${NC}"
    if [ -e "/dev/accel/accel0" ]; then
        echo -e "  Dispositivo: ${GREEN}/dev/accel/accel0 (Presente)${NC}"
    else
        echo -e "  Dispositivo: ${RED}/dev/accel/accel0 (Ausente)${NC}"
    fi

    if [ -x "$VENV_PYTHON" ]; then
        $VENV_PYTHON -c "
import openvino as ov
c = ov.Core()
devs = c.available_devices
npu_str = 'Disponível (Intel AI Boost)' if 'NPU' in devs else 'Indisponível'
print(f'  OpenVINO Backend: {devs}')
print(f'  Status da NPU: {npu_str}')
" 2>/dev/null
    fi

    # 2. Virtual Devices
    echo -e "\n${BLUE}[Dispositivos Virtuais]${NC}"
    if [ -e "/dev/video72" ]; then
        echo -e "  Câmera Virtual: ${GREEN}/dev/video72 (Intel NPU Enhanced Webcam - 1080p)${NC}"
    else
        echo -e "  Câmera Virtual: ${RED}/dev/video72 (Não carregado)${NC}"
    fi

    if pactl list sources short 2>/dev/null | grep -q "npu_clearvoice"; then
        echo -e "  Microfone Virtual: ${GREEN}npu_clearvoice (Ativo no PipeWire)${NC}"
    else
        echo -e "  Microfone Virtual: ${YELLOW}npu_clearvoice (Inativo)${NC}"
    fi

    # 3. Services Status
    echo -e "\n${BLUE}[Serviços de Segundo Plano]${NC}"
    for s in npu-webcam npu-audio; do
        if systemctl --user is-active --quiet "$s"; then
            echo -e "  $s: ${GREEN}Ativo (Executando)${NC}"
        else
            echo -e "  $s: ${YELLOW}Parado${NC}"
        fi
    done

    # 4. Current Configuration
    echo -e "\n${BLUE}[Configurações Atuais (~/.config/npu-effects/config.json)]${NC}"
    if [ -f "$CONFIG_FILE" ]; then
        $VENV_PYTHON -c "
import json
with open('$CONFIG_FILE') as f:
    cfg = json.load(f)
v = cfg.get('video', {})
a = cfg.get('audio', {})
print(f'  Webcam Desfoque Fundo: {\"ATIVO\" if v.get(\"blur_enabled\") else \"DESATIVADO\"} (Modo: {v.get(\"blur_mode\", \"standard\").upper()}, Intensidade: {v.get(\"blur_strength\", 35)}, Borda: {v.get(\"mask_feather\", 40)}px)')
print(f'  Webcam Auto-Framing:   {\"ATIVO\" if v.get(\"auto_framing\") else \"DESATIVADO\"} (Modo: {v.get(\"framing_mode\", \"single\").upper()}, Fluidez: {v.get(\"framing_smoothness_int\", 4)}/10, Zona Morta: {int(v.get(\"framing_deadzone\", 0.10) * 100)}%)')
print(f'  Webcam Filtro Artístico: {v.get(\"artistic_filter\", \"off\").upper()} (Intensidade: {v.get(\"artistic_strength\", 70)})')
print(f'  Webcam Cor Cinema:     {v.get(\"color_filter\", \"none\").upper()} (Intensidade: {v.get(\"color_strength\", 70)})')
print(f'  Webcam Luz de Recorte: {\"ATIVO (\" + str(v.get(\"rim_light_color\", \"warm\")) + \", \" + str(v.get(\"rim_light_intensity\", 50)) + \"%)\" if v.get(\"rim_light_enabled\") else \"DESATIVADO\"}')
print(f'  Webcam Reflexo de Tela:{\"ATIVO (\" + str(v.get(\"screen_glare_strength\", 50)) + \"%)\" if v.get(\"screen_glare_enabled\") else \"DESATIVADO\"}')
print(f'  Webcam Parallax 3D:    {\"ATIVO (\" + str(v.get(\"parallax_strength\", 40)) + \"%)\" if v.get(\"parallax_enabled\") else \"DESATIVADO\"}')
print(f'  Webcam Gestos Manuais: {\"ATIVO (\" + str(v.get(\"gesture_action\", \"all\")).upper() + \")\" if v.get(\"gesture_detection_enabled\", True) else \"DESATIVADO\"}')
print(f'  Webcam Reter Objetos:  {\"ATIVO (\" + str(v.get(\"object_retention_strength\", 60)) + \"%)\" if v.get(\"object_retention_enabled\", True) else \"DESATIVADO\"}')
print(f'  Webcam Reter Cadeira:  {\"ATIVO (Modelo Neural NPU - \" + str(v.get(\"chair_retention_strength\", 50)) + \"%)\" if v.get(\"chair_retention_enabled\", True) else \"DESATIVADO\"}')
print(f'  Webcam Fade Ausência:  {\"ATIVO (Fade Suave)\" if v.get(\"privacy_fade_enabled\", True) else \"DESATIVADO (Corte Seco)\"}')
print(f'  Webcam Suavização/Denoise: {\"ATIVO\" if v.get(\"smooth_enabled\") else \"DESATIVADO\"} (Nível: {v.get(\"smooth_strength\", 50)})')
print(f'  Webcam Luz de Estúdio: {\"ATIVO\" if v.get(\"studio_light_enabled\") else \"DESATIVADO\"} (Ganho: {v.get(\"studio_light_gain\", 40)})')
print(f'  Webcam Pouca Luz:      {\"ATIVO\" if v.get(\"low_light_enabled\") else \"DESATIVADO\"} (Ganho: {v.get(\"low_light_gain\", 45)})')
print(f'  Webcam Nitidez/Sharpen:{\"ATIVO\" if v.get(\"sharpen_enabled\") else \"DESATIVADO\"} (Força: {v.get(\"sharpen_strength\", 35)})')
print(f'  Webcam Contato Visual: {str(v.get(\"eye_contact_mode\", \"natural\" if v.get(\"eye_contact_enabled\") else \"off\")).upper()}')
print(f'  Webcam Auto-Standby:   {\"ATIVO (Desliga ociosa)\" if v.get(\"auto_standby\", True) else \"DESATIVADO (Sempre ligada)\"}')
print(f'  Webcam PTZ Park:       {\"ATIVO (Tilt: \" + str(v.get(\"standby_tilt_value\", -324000)) + \", Atraso: \" + str(v.get(\"standby_park_delay\", 1.0)) + \"s)\" if v.get(\"ptz_park_on_standby\", True) else \"DESATIVADO\"}')
if v.get(\"standby_command\"):
    print(f'  Standby Hook Cmd:      {v.get(\"standby_command\")}')
if v.get(\"wakeup_command\"):
    print(f'  Wakeup Hook Cmd:       {v.get(\"wakeup_command\")}')
priv_img = v.get(\"privacy_image\", \"\")
print(f'  Webcam Privacidade:    {\"ATIVO\" if v.get(\"privacy_enabled\") else \"DESATIVADO\"} (Imagem: {priv_img if priv_img else \"Tela gráfica padrão\"})')
bg = v.get(\"background_image\", \"\")
print(f'  Webcam Fundo Virtual:  {bg if bg else \"Nenhum (usando desfoque)\"}')
print(f'  Áudio Cancelamento Ruído: {\"ATIVO (NPU PoCoNet)\" if a.get(\"noise_suppression\") else \"DESATIVADO\"}')
print(f'  Áudio Pacote Estúdio:     {\"ATIVO\" if a.get(\"studio_mic_enabled\", True) else \"DESATIVADO\"}')
print(f'  Áudio Low-Cut (80Hz):     {\"ATIVO\" if a.get(\"lowcut_enabled\", True) else \"DESATIVADO\"}')
print(f'  Áudio EQ Presença Vocal:  {\"ATIVO\" if a.get(\"studio_eq_enabled\", True) else \"DESATIVADO\"}')
print(f'  Áudio De-Esser (Sibil):   {\"ATIVO\" if a.get(\"deesser_enabled\", True) else \"DESATIVADO\"}')
print(f'  Áudio Gate/VAD Silêncio:  {\"ATIVO (\" + str(a.get(\"gate_threshold_db\", -45.0)) + \" dB)\" if a.get(\"gate_enabled\", True) else \"DESATIVADO\"}')
print(f'  Áudio Compressor/AGC:     {\"ATIVO (Alvo: \" + str(a.get(\"comp_target_db\", -18.0)) + \" dB)\" if a.get(\"compressor_enabled\", True) else \"DESATIVADO\"}')
print(f'  Áudio Desreverberação:    {\"ATIVO (\" + str(a.get(\"dereverb_strength\", 40)) + \"%)\" if a.get(\"dereverb_enabled\", True) else \"DESATIVADO\"}')
" 2>/dev/null
    fi
    echo -e "${CYAN}====================================================${NC}"
}

cmd_blur() {
    ensure_config
    arg="$1"
    $VENV_PYTHON -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)

arg = '$arg'.lower()
if arg in ['on', 'true', '1', 'ativar', 'sim']:
    cfg['video']['blur_enabled'] = True
    print('Desfoque de fundo ATIVADO!')
elif arg in ['off', 'false', '0', 'desativar', 'nao']:
    cfg['video']['blur_enabled'] = False
    print('Desfoque de fundo DESATIVADO!')
elif arg.isdigit():
    val = max(5, min(99, int(arg)))
    cfg['video']['blur_enabled'] = True
    cfg['video']['blur_strength'] = val
    print(f'Intensidade do desfoque ajustada para {val}!')
else:
    print('Uso: npu-ctl blur [on | off | <intensidade 5-99>]')
    exit(1)

with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
"
}

