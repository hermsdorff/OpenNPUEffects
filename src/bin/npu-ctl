import json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)
arg = '$arg'.lower()
if arg in ['on', 'true', '1', 'ativar', 'sim']:
    cfg['audio']['compressor_enabled'] = True
    print('Compressor Vocal e Auto Gain (AGC) ATIVADO!')
elif arg in ['off', 'false', '0', 'desativar', 'nao']:
    cfg['audio']['compressor_enabled'] = False
    print('Compressor Vocal e Auto Gain (AGC) DESATIVADO!')
elif arg.lstrip('-').replace('.', '', 1).isdigit():
    val = float(arg)
    val = max(-30.0, min(-10.0, -abs(val)))
    cfg['audio']['compressor_enabled'] = True
    cfg['audio']['comp_target_db'] = val
    print(f'Nível alvo do Compressor/AGC ajustado para {val} dB!')
else:
    print('Uso: npu-ctl mic-comp [on | off | <alvo em dB ex: -18>]')
    exit(1)
with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
"
}

cmd_mic_dereverb() {
    ensure_config
    arg="$1"
    $VENV_PYTHON -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)
arg = '$arg'.lower()
if arg in ['on', 'true', '1', 'ativar', 'sim']:
    cfg['audio']['dereverb_enabled'] = True
    print('Desreverberação de Sala (De-Reverb) ATIVADA!')
elif arg in ['off', 'false', '0', 'desativar', 'nao']:
    cfg['audio']['dereverb_enabled'] = False
    print('Desreverberação de Sala (De-Reverb) DESATIVADA!')
elif arg.isdigit():
    val = max(10, min(100, int(arg)))
    cfg['audio']['dereverb_enabled'] = True
    cfg['audio']['dereverb_strength'] = val
    print(f'Intensidade da Desreverberação ajustada para {val}%!')
else:
    print('Uso: npu-ctl mic-dereverb [on | off | <força 10-100>]')
    exit(1)
with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
"
}

