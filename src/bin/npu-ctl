        echo "Uso do npu-ctl:"
        echo "  npu-ctl status                   Exibe status da NPU, dispositivos e serviços"
        echo "  npu-ctl cam-source [<1,2..|auto>] Seleciona qual webcam física (PIXY ou Notebook) alimenta a NPU"
