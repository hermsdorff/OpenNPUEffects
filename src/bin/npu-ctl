cmd_ptz_test() {
    tilt_val="$1"
    pan_val="$2"
    dev="/dev/video1"
    for l in /dev/v4l/by-id/*-video-index0; do
        if [ -e "$l" ]; then
            dev=$(realpath "$l")
            break
        fi
    done
    if [ -z "$tilt_val" ]; then
        echo "Uso: npu-ctl ptz-test <tilt_valor> [pan_valor]"
        echo "Exemplos:"
        echo "  npu-ctl ptz-test -324000       # Inclina para baixo"
        echo "  npu-ctl ptz-test 0             # Centraliza o tilt (reto)"
        echo "  npu-ctl ptz-test 324000        # Inclina para cima"
        echo "  npu-ctl ptz-test -324000 540000 # Inclina para baixo e gira pan"
        return
    fi
    if [ -n "$pan_val" ]; then
        echo "Ajustando Pan para $pan_val em $dev..."
        v4l2-ctl -d "$dev" --set-ctrl="pan_absolute=$pan_val"
    fi
    echo "Ajustando Tilt para $tilt_val em $dev..."
    v4l2-ctl -d "$dev" --set-ctrl="tilt_absolute=$tilt_val"
    echo "Comando PTZ executado!"
}

