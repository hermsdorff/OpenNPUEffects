cmd_rim() {
    ensure_config
    arg1="$1"
    arg2="$2"
    $VENV_PYTHON -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)

arg1 = '$arg1'.lower()
arg2 = '$arg2'.lower()

if arg1 in ['on', 'true', '1', 'ativar', 'sim']:
    cfg['video']['rim_light_enabled'] = True
    print('Luz de recorte (Rim / Hair Light) ATIVADA!')
elif arg1 in ['off', 'false', '0', 'desativar', 'nao']:
    cfg['video']['rim_light_enabled'] = False
    print('Luz de recorte (Rim / Hair Light) DESATIVADA!')
elif arg1.isdigit():
    val = max(10, min(100, int(arg1)))
    cfg['video']['rim_light_enabled'] = True
    cfg['video']['rim_light_intensity'] = val
    print(f'Intensidade da luz de recorte ajustada para {val}!')
else:
    print('Uso: npu-ctl rim [on | off | <intensidade 10-100>] [warm | white | cool]')
    exit(1)

if arg2 in ['warm', 'quente', 'ambar']:
    cfg['video']['rim_light_color'] = 'warm'
    print('Tonalidade da luz de recorte: ÂMBAR / QUENTE')
elif arg2 in ['white', 'branco', 'neutro']:
    cfg['video']['rim_light_color'] = 'white'
    print('Tonalidade da luz de recorte: BRANCO NEUTRO')
elif arg2 in ['cool', 'frio', 'azul', 'cyber']:
    cfg['video']['rim_light_color'] = 'cool'
    print('Tonalidade da luz de recorte: AZUL ESTÚDIO')

with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
"
}

