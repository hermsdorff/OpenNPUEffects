cmd_mic_listen() {
    arg="${1:-on}"
    case "$arg" in
        on|start|ativar)
            if pactl list modules short 2>/dev/null | grep -q "module-loopback.*npu_clearvoice"; then
                echo -e "${YELLOW}Monitoramento de áudio (escuta ao vivo) já está ATIVADO!${NC}"
                return
            fi
            echo -e "${CYAN}====================================================${NC}"
            echo -e "${CYAN}        ESCUTA AO VIVO (MONITORAMENTO NPU)          ${NC}"
            echo -e "${CYAN}====================================================${NC}"
            echo -e "${BLUE}Conectando 'npu_clearvoice' diretamente à sua saída de áudio...${NC}"
            echo -e "${YELLOW}Atenção: Use fones de ouvido para evitar retorno de som (microfonia)!${NC}\n"
            mod_id=$(pactl load-module module-loopback source=npu_clearvoice latency_msec=20 2>/dev/null)
            if [ -n "$mod_id" ]; then
                echo "$mod_id" > /tmp/.npu_loopback_id
                echo -e "${GREEN}✓ Escuta ao vivo ATIVADA!${NC}"
                echo -e "Fale, bata palmas, digite no teclado ou faça barulhos para ouvir a IA em tempo real."
                echo -e "Para encerrar o monitoramento, digite: ${CYAN}npu-ctl mic-listen off${NC}"
            else
                echo -e "${RED}Falha ao iniciar o loopback de áudio.${NC}"
            fi
            ;;
        off|stop|desativar)
            echo "Desativando escuta ao vivo..."
            if [ -f /tmp/.npu_loopback_id ]; then
                id=$(cat /tmp/.npu_loopback_id)
                pactl unload-module "$id" 2>/dev/null
                rm -f /tmp/.npu_loopback_id
            fi
            for m in $(pactl list modules short 2>/dev/null | grep "module-loopback" | awk '{print $1}'); do
                pactl unload-module "$m" 2>/dev/null
            done
            echo -e "${GREEN}✓ Escuta ao vivo DESATIVADA.${NC}"
            ;;
        *)
            echo "Uso: npu-ctl mic-listen [on | off]"
            ;;
    esac
}

cmd_audio_test() {
    dur="${1:-5}"
    echo -e "${CYAN}====================================================${NC}"
    echo -e "${CYAN}        TESTE DE GRAVAÇÃO E CANCELAMENTO NPU        ${NC}"
    echo -e "${CYAN}====================================================${NC}"
    echo -e "${BLUE}Gravando ${dur} segundos a partir do microfone limpo com IA ('npu_clearvoice')...${NC}"
    echo -e "${YELLOW}Fale algo, bata palmas ou digite no teclado agora!${NC}"
    
    tmp_wav="/tmp/npu_test_recording.wav"
    rm -f "$tmp_wav"
    
    timeout "${dur}" parecord -d npu_clearvoice --file-format=wav "$tmp_wav" 2>/dev/null
    
    if [ -f "$tmp_wav" ]; then
        echo -e "\n${GREEN}✓ Gravação concluída! Reproduzindo áudio agora para você escutar:${NC}"
        paplay "$tmp_wav" 2>/dev/null || aplay "$tmp_wav" 2>/dev/null
        rm -f "$tmp_wav"
        echo -e "\n${GREEN}Teste finalizado com sucesso!${NC}"
    else
        echo -e "${RED}Erro ao gravar áudio de teste. Verifique se o serviço npu-audio está ativo.${NC}"
    fi
}

