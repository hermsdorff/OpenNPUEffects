cmd_privacy() {
    ensure_config
    arg="$1"
    $VENV_PYTHON -c "
import os, json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)

arg = '$arg'.strip()
arg_lower = arg.lower()

if arg_lower in ['on', 'true', '1', 'ativar', 'sim', '']:
    cfg['video']['privacy_enabled'] = True
    print('Modo de privacidade por ausência ATIVADO!')
elif arg_lower in ['off', 'false', '0', 'desativar', 'nao']:
    cfg['video']['privacy_enabled'] = False
    print('Modo de privacidade por ausência DESATIVADO!')
elif arg_lower in ['none', 'remover', 'limpar', 'padrao', 'default']:
    cfg['video']['privacy_image'] = ''
    print('Imagem de privacidade customizada removida. Usando tela padrão!')
else:
    abs_path = os.path.abspath(os.path.expanduser(arg))
    bg_dir = os.path.expanduser('~/.config/npu-effects/backgrounds')
    pic_dir = os.path.expanduser('~/Pictures')
    if not os.path.exists(abs_path):
        if os.path.exists(os.path.join(bg_dir, arg)):
            abs_path = os.path.join(bg_dir, arg)
        elif os.path.exists(os.path.join(pic_dir, arg)):
            abs_path = os.path.join(pic_dir, arg)
        elif os.path.exists(os.path.join(pic_dir, os.path.basename(arg))):
            abs_path = os.path.join(pic_dir, os.path.basename(arg))
        elif os.path.exists(os.path.join(bg_dir, os.path.basename(arg))):
            abs_path = os.path.join(bg_dir, os.path.basename(arg))

    if os.path.exists(abs_path):
        cfg['video']['privacy_enabled'] = True
        cfg['video']['privacy_image'] = abs_path
        print(f'Modo de privacidade ATIVADO com imagem: {abs_path}')
    else:
        print(f'Erro: arquivo de imagem não encontrado: {abs_path}')
        print('Uso: npu-ctl privacy [on | off | /caminho/para/imagem.jpg]')
        exit(1)

with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
"
}

