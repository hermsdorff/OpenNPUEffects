cmd_artistic() {
    ensure_config
    arg1="$1"
    arg2="$2"
    $VENV_PYTHON -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)

arg1 = '$arg1'.lower()
arg2 = '$arg2'

if arg1 in ['off', 'desativar', 'nao', '0']:
    cfg['video']['artistic_filter'] = 'off'
    print('Filtro artístico DESATIVADO!')
elif arg1 in ['illustrated', 'ilustrado', 'hq', 'comic']:
    cfg['video']['artistic_filter'] = 'illustrated'
    print('Filtro artístico ILUSTRADO (HQ / Cel-Shading) ATIVADO!')
elif arg1 in ['animated', 'animado', 'cartoon', 'anime']:
    cfg['video']['artistic_filter'] = 'animated'
    print('Filtro artístico ANIMADO (Cartoon / Anime) ATIVADO!')
elif arg1 in ['watercolor', 'aquarela']:
    cfg['video']['artistic_filter'] = 'watercolor'
    print('Filtro artístico AQUARELA (Watercolor) ATIVADO!')
else:
    print('Uso: npu-ctl artistic [off | illustrated | animated | watercolor] [<intensidade 10-100>]')
    exit(1)

if arg2.isdigit():
    val = max(10, min(100, int(arg2)))
    cfg['video']['artistic_strength'] = val
    print(f'Intensidade artística ajustada para {val}!')

with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
"
}

