        echo "  npu-ctl studio-mic [on|off]      Ativa ou desativa o pacote de estúdio vocal (EQ+Comp+Gate+De-Esser)"
        echo "  npu-ctl mic-noise [on|off]       Ativa ou desativa supressão de ruído IA na NPU (PoCoNet)"
        echo "  npu-ctl mic-gate [on|off|<dB>]   Ativa/desativa silêncio absoluto nas pausas da fala (VAD -45dB)"
        echo "  npu-ctl mic-comp [on|off|<dB>]   Ativa/desativa compressor vocal e auto-gain (AGC -18dB)"
        echo "  npu-ctl mic-eq [on|off]          Ativa/desativa equalizador vocal de presença e calor"
        echo "  npu-ctl mic-deesser [on|off]     Ativa/desativa atenuador de sibilâncias estridentes (S/CH)"
        echo "  npu-ctl mic-dereverb [on|off|<%>] Ativa/desativa desreverberação para salas com eco"
        echo "  npu-ctl mic-lowcut [on|off]      Ativa/desativa corte de ruídos de mesa e vibração (80Hz)"
        echo "  npu-ctl mic-listen [on|off]      Escuta ao vivo o áudio tratado pela NPU no fone (loopback)"
        echo "  npu-ctl audio-test [segundos]    Grava X segundos e reproduz para você ouvir a qualidade da IA"
