cmd_framing() {
    ensure_config
    arg1="$1"
    arg2="$2"
    $VENV_PYTHON -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)

arg1 = '$arg1'.lower()
arg2 = '$arg2'.lower()

if arg1 in ['on', 'true', '1', 'ativar', 'sim']:
    cfg['video']['auto_framing'] = True
    print('Auto-framing ATIVADO!')
elif arg1 in ['off', 'false', '0', 'desativar', 'nao']:
    cfg['video']['auto_framing'] = False
    print('Auto-framing DESATIVADO!')
elif arg1 in ['smooth', 'fluidez', 'suavidade'] or (arg1.isdigit() and int(arg1) <= 10):
    val = int(arg2) if arg1 in ['smooth', 'fluidez', 'suavidade'] and arg2.isdigit() else int(arg1)
    val = max(1, min(10, val))
    cfg['video']['auto_framing'] = True
    cfg['video']['framing_smoothness_int'] = val
    cfg['video']['framing_smoothness'] = round(val * 0.01, 3)
    print(f'Fluidez do Auto-Framing ajustada para {val}/10 (smoothness={round(val * 0.01, 3)})!')
elif arg1 in ['deadzone', 'zonamorta', 'zona']:
    val = int(arg2) if arg2.isdigit() else 10
    val = max(5, min(30, val))
    cfg['video']['framing_deadzone'] = round(val / 100.0, 2)
    print(f'Zona morta (deadzone) do Auto-Framing ajustada para {val}%!')
else:
    print('Uso: npu-ctl framing [on | off | smooth <1-10> | deadzone <5-30>]')
    exit(1)

with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
"
}

cmd_background() {
    ensure_config
    img_path="$1"
    $VENV_PYTHON -c "
import os, json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)

arg = '$img_path'
if arg.lower() in ['none', 'off', 'remover', 'limpar', '']:
    cfg['video']['background_image'] = ''
    print('Fundo virtual removido. Voltando ao modo de desfoque!')
else:
    abs_path = os.path.abspath(os.path.expanduser(arg))
    bg_dir = os.path.expanduser('~/.config/npu-effects/backgrounds')
    pic_dir = os.path.expanduser('~/Pictures')
    if not os.path.exists(abs_path):
        if os.path.exists(os.path.join(bg_dir, arg)):
            abs_path = os.path.join(bg_dir, arg)
        elif os.path.exists(os.path.join(pic_dir, arg)):
            abs_path = os.path.join(pic_dir, arg)
        elif os.path.exists(os.path.join(pic_dir, os.path.basename(arg))):
            abs_path = os.path.join(pic_dir, os.path.basename(arg))
        elif os.path.exists(os.path.join(bg_dir, os.path.basename(arg))):
            abs_path = os.path.join(bg_dir, os.path.basename(arg))

    if os.path.exists(abs_path):
        cfg['video']['background_image'] = abs_path
        print(f'Fundo virtual definido para: {abs_path}')
    else:
        print(f'Erro: arquivo não encontrado: {abs_path}')
        exit(1)

with open('$CONFIG_FILE', 'w') as f:
    json.dump(cfg, f, indent=2)
"
}

