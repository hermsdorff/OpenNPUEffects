+                elif is_modnet:
+                    # MODNet Portrait Matting (Apache 2.0): preprocessing (BGR->RGB, mean/scale
+                    # normalization) is baked into the IR, so we feed a raw 512x512 BGR uint8 frame.
+                    small = cv2.resize(framed, (512, 512))
+                    blob = np.expand_dims(small.astype(np.uint8), axis=0)  # (1, 512, 512, 3) uint8 BGR
+
+                    infer_request.infer({seg_inp_name: blob})
+                    alpha = infer_request.get_tensor(seg_out_name).data[0, 0]  # (512, 512) float32 [0,1]
+
+                    # Downscale to the same 256x256 coordinate space used by the multiclass
+                    # pipeline so temporal blend / feather / guided filter stay unchanged.
+                    p_person = cv2.resize(alpha, (256, 256), interpolation=cv2.INTER_LINEAR)
+
+                    # MODNet has no hand/skin channel, so handheld-object retention and hand
+                    # gesture triggers are unavailable in this mode (has_hands stays undefined,
+                    # matching the fact that neither feature is referenced outside this block).
+
+                    # 2.1 Neural Chair & Headrest Retention still applies (only needs p_person + framed)
+                    if cfg.get("chair_retention_enabled", True):
